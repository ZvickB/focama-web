SERPAPI_API_KEY=your-serpapi-key
OPENAI_API_KEY=your-openai-key
OPENAI_MODEL=gpt-5-mini
# Optional fail-open timeout for query moderation (milliseconds)
OPENAI_MODERATION_TIMEOUT_MS=2000

# Optional Supabase-backed persistence for cache/history
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-key
# Optional legacy fallback if your project only exposes the older key type
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional cache tuning
SEARCH_CACHE_TTL_MINUTES=1440

# Optional shadow-only human detection for images already hidden by moderation.
# This never reveals images or changes API responses.
SENSITIVE_IMAGE_SHADOW_ENABLED=false
# Optional comma-separated HTTPS image hosts in addition to known Amazon image hosts.
SENSITIVE_IMAGE_SHADOW_ALLOWED_HOSTS=

# Optional Deep Dive controls
DEEP_DIVE_ENABLED=false
DEEP_DIVE_REQUIRE_AUTH=true
# Set true only in controlled testing to bypass the non-subscriber free-use cap.
DEEP_DIVE_FREE_LIMIT_DISABLED=false
# Non-subscriber free-use cap. Subscribers and allowlisted testers are unlimited.
DEEP_DIVE_FREE_LIMIT=1
# Temporary tester/subscriber allowlists until billing/account tables exist.
DEEP_DIVE_SUBSCRIBER_EMAILS=
DEEP_DIVE_SUBSCRIBER_USER_IDS=
