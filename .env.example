SERPAPI_API_KEY=your-serpapi-key
OPENAI_API_KEY=your-openai-key
# Follow-up questions, query-quality review, and retry advice.
OPENAI_REFINEMENT_MODEL=gpt-5.6-luna
# Async shortlist explanations and Improve Picks suggestions. Defaults to this value when omitted.
OPENAI_FINALIZE_MODEL=gpt-5.6-luna
# Optional fail-open timeout for query moderation (milliseconds)
OPENAI_MODERATION_TIMEOUT_MS=2000

# Web retry behavior. Default is true: Improve Picks retries auto-finalize like mobile.
# Set to false to restore the extra web refinement step after a retry search.
VITE_AUTO_FINALIZE_RETRY_SEARCH=true

# Web results layout. Default is true: Improve Picks is an in-grid/list endcap.
# Set to false to restore the previous standalone Improve Picks card.
VITE_INLINE_IMPROVE_PICKS=true

# Optional tester rollout: comparable Google Shopping options after no lower exact price is found.
SIMILAR_OPTIONS_ENABLED=false

# Optional Supabase-backed persistence for cache/history
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-key
# Comma-separated verified account emails excluded by the analytics dashboard's "External only" view.
# INTERNAL_ANALYTICS_EMAILS=zvickb2@gmail.com
# Optional legacy fallback if your project only exposes the older key type
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional cache tuning
SEARCH_CACHE_TTL_MINUTES=1440
# Search requests use the fast process-local limiter by default. Set to
# `supabase` only when deliberately testing the slower shared limiter.
RATE_LIMIT_STORAGE=memory
RATE_LIMIT_STORAGE_TIMEOUT_MS=500
DISCOVERY_CACHE_READ_TIMEOUT_MS=750
# Bounds background resource use; this timeout does not delay preview rendering.
DISCOVERY_SESSION_BACKGROUND_TIMEOUT_MS=5000
# Newly issued tokens can wait briefly here only if finalize beats the
# nonblocking session write to shared storage.
DISCOVERY_SESSION_READY_TIMEOUT_MS=2500
SENSITIVE_IMAGE_VERDICT_TIMEOUT_MS=500

# Paid Rainforest searches have a separate process-local guard. Cache hits do
# not consume these tokens or concurrency slots.
RAINFOREST_SEARCH_RATE_LIMIT=4
RAINFOREST_SEARCH_RATE_WINDOW_MS=10000
RAINFOREST_SEARCH_MAX_CONCURRENCY=4

# Optional Sightengine analysis for images already hidden by moderation.
SENSITIVE_IMAGE_SHADOW_ENABLED=false
# Restore only images with a current explicit cached `show` verdict.
# Production currently enables this for the controlled tester rollout.
SENSITIVE_IMAGE_REVEAL_ENABLED=false
SIGHTENGINE_API_USER=your-sightengine-api-user
SIGHTENGINE_API_SECRET=your-sightengine-api-secret
# Optional API timeout in milliseconds (1000-30000; default 10000).
SIGHTENGINE_TIMEOUT_MS=10000
# Optional comma-separated HTTPS image hosts in addition to known Amazon image hosts.
SENSITIVE_IMAGE_SHADOW_ALLOWED_HOSTS=

# Optional Deep Dive controls
DEEP_DIVE_ENABLED=false
DEEP_DIVE_REQUIRE_AUTH=true
# Set true only in controlled testing to bypass the non-subscriber free-use cap.
DEEP_DIVE_FREE_LIMIT_DISABLED=false
# Non-subscriber free-use cap. Subscribers and allowlisted testers are unlimited.
DEEP_DIVE_FREE_LIMIT=1
# Temporary tester/subscriber allowlists until billing/account tables exist.
DEEP_DIVE_SUBSCRIBER_EMAILS=
DEEP_DIVE_SUBSCRIBER_USER_IDS=
