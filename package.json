{
  "name": "focamai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "node backend/scripts/dev-all.js",
    "server": "node backend/express-server.js",
    "server:express": "node backend/express-server.js",
    "cache:search": "node backend/scripts/save-serpapi-cache.js",
    "cache:full-response": "node backend/scripts/save-serpapi-full-response.js",
    "experiment:sensitive-images": "node experiments/sensitive-image-classification/evaluate-images.js",
    "test:smoke:haiku-luna": "node --env-file=.env backend/scripts/smoke-haiku-luna.js",
    "test:smoke:fallback-quality": "node --env-file=.env backend/scripts/smoke-deterministic-fallback.js",
    "test:benchmark:ai-payloads": "node --env-file=.env backend/scripts/benchmark-ai-payloads.js",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "SMOKE=1 vitest run backend/smoke.test.js",
    "test:smoke:e2e": "SMOKE=1 SMOKE_E2E=1 vitest run backend/smoke.test.js",
    "test:smoke:cache": "SMOKE=1 SMOKE_CACHE_BENCH=1 vitest run backend/smoke.test.js",
    "test:smoke:cache-ui": "vitest run src/pages/HomePage.cache-latency.smoke.test.jsx",
    "test:smoke:cache-ui:live": "node backend/scripts/smoke-cache-ui-live.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@sentry/node": "^10.52.0",
    "@supabase/supabase-js": "^2.99.3",
    "@tanstack/react-query": "^5.94.5",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "lucide-react": "^0.577.0",
    "motion": "^12.38.0",
    "multer": "^2.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.1",
    "resend": "^6.14.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@tensorflow-models/coco-ssd": "^2.2.3",
    "@tensorflow-models/face-detection": "^1.0.3",
    "@tensorflow-models/pose-detection": "^2.1.3",
    "@tensorflow/tfjs": "^4.22.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.24",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^29.0.0",
    "postcss": "^8.5.6",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.17",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.0"
  },
  "allowScripts": {
    "esbuild@0.27.3": true,
    "fsevents@2.3.3": true
  }
}
